[sub_resource type="Resource" id="Resource_ojv1e"]
script = ExtResource("2_qs0nk")
id = &"bear"
display_name = "Медведь"
description = "Стойкость и сопротивление урону, пока вы в ярости."

[sub_resource type="Resource" id="Resource_g6a1v"]
script = ExtResource("2_qs0nk")
id = &"eagle"
display_name = "Орёл"
description = "Подвижность: рывок и уход от атак в ярости."

[sub_resource type="Resource" id="Resource_uiepd"]
