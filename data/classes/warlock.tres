id = &"pact_magic"
display_name = "Магия договора"
description = "Ваши ячейки заклинаний восстанавливаются на коротком отдыхе, а не на долгом. На 1 уровне — одна ячейка 1 круга."

[sub_resource type="Resource" id="Resource_k5sv0"]
