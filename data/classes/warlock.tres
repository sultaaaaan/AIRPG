[resource]
script = ExtResource("4_nmr1f")
id = &"warlock"
display_name = "Колдун"
description = "Искатель тайных знаний, обменявший часть себя на силу покровителя."
primary_abilities = Array[StringName]([&"charisma"])
saving_throws = Array[StringName]([&"wisdom", &"charisma"])
armor_training = Array[StringName]([&"light"])
weapon_training = Array[StringName]([&"simple"])
skill_pool = Array[StringName]([&"arcana", &"deception", &"history", &"intimidation", &"investigation", &"nature", &"religion"])
features = Array[ExtResource("3_isxne")]([SubResource("Resource_dc7pg"), SubResource("Resource_dumyp"), SubResource("Resource_k5sv0"), SubResource("Resource_rgurw")])
spellcasting = SubResource("Resource_nwqdf")
equipment_pack = Array[ExtResource("2_rgurw")]([SubResource("Resource_ykqqk"), SubResource("Resource_47u6a"), SubResource("Resource_fm5jb"), SubResource("Resource_f31if"), SubResource("Resource_86lxv")])
alternative_gold = 100
