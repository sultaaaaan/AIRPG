[sub_resource type="Resource" id="Resource_g4g52"]
script = ExtResource("6_vttfb")
ability = &"wisdom"
cantrips_known = 2
spells_prepared = 4
level_1_slots = 2
secret_language = &"druidic"

[resource]
script = ExtResource("5_pl2tb")
id = &"druid"
display_name = "Друид"
description = "Хранитель природного равновесия, повелевающий стихиями и зверями."
primary_abilities = Array[StringName]([&"wisdom"])
saving_throws = Array[StringName]([&"intelligence", &"wisdom"])
armor_training = Array[StringName]([&"light", &"medium", &"shields"])
weapon_training = Array[StringName]([&"simple"])
tool_proficiencies = Array[StringName]([&"herbalism_kit"])
skill_pool = Array[StringName]([&"animal_handling", &"arcana", &"insight", &"medicine", &"nature", &"perception", &"religion", &"survival"])
features = Array[ExtResource("3_o1okr")]([SubResource("Resource_23gt4"), SubResource("Resource_da2k8"), SubResource("Resource_2lfdl"), SubResource("Resource_o1okr")])
choices = Array[ExtResource("1_da2k8")]([SubResource("Resource_0c33o")])
spellcasting = SubResource("Resource_g4g52")
equipment_pack = Array[ExtResource("4_1idy1")]([SubResource("Resource_35ciw"), SubResource("Resource_g3x4n"), SubResource("Resource_tslkq"), SubResource("Resource_afn7e"), SubResource("Resource_7lp64"), SubResource("Resource_5dshn")])
alternative_gold = 100
