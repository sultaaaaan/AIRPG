[sub_resource type="Resource" id="Resource_dt3c4"]
script = ExtResource("3_o1okr")
id = &"magician_bonus"
display_name = "Тайные знания"
description = "+модификатор Мудрости к проверкам Магии и Природы, один дополнительный заговор."

[sub_resource type="Resource" id="Resource_hrk42"]
script = ExtResource("2_2lfdl")
id = &"magician"
display_name = "Маг"
description = "Вы знаете один дополнительный заговор друида и добавляете модификатор Мудрости к проверкам Тайных знаний (Магия) и Природы."
features = Array[ExtResource("3_o1okr")]([SubResource("Resource_dt3c4")])

[sub_resource type="Resource" id="Resource_52k3s"]
script = ExtResource("2_2lfdl")
id = &"warden"
display_name = "Хранитель"
description = "Вы получаете владение воинским оружием и средними доспехами."
granted_armor_training = Array[StringName]([&"medium"])
granted_weapon_training = Array[StringName]([&"martial"])

[sub_resource type="Resource" id="Resource_0c33o"]
script = ExtResource("1_da2k8")
id = &"primal_order"
prompt = "Выберите первобытный орден"
options = Array[ExtResource("2_2lfdl")]([SubResource("Resource_hrk42"), SubResource("Resource_52k3s")])

[sub_resource type="Resource" id="Resource_35ciw"]
script = ExtResource("4_1idy1")
