[sub_resource type="Resource" id="Resource_o1okr"]
script = ExtResource("3_o1okr")
id = &"wild_resurgence"
display_name = "Возрождение природы"
description = "Вы можете потратить ячейку заклинания, чтобы восстановить использование Дикого облика, или наоборот."
