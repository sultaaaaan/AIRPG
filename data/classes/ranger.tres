[resource]
script = ExtResource("4_le6i0")
id = &"ranger"
display_name = "Следопыт"
description = "Охотник на границе диких земель, владеющий оружием и первичной магией."
hit_die = 10
primary_abilities = Array[StringName]([&"dexterity", &"wisdom"])
saving_throws = Array[StringName]([&"strength", &"dexterity"])
weapon_mastery_count = 2
armor_training = Array[StringName]([&"light", &"medium", &"shields"])
weapon_training = Array[StringName]([&"simple", &"martial"])
skill_choice_count = 3
skill_pool = Array[StringName]([&"animal_handling", &"athletics", &"insight", &"investigation", &"nature", &"perception", &"stealth", &"survival"])
features = Array[ExtResource("3_rgfmb")]([SubResource("Resource_i6qni"), SubResource("Resource_viavt"), SubResource("Resource_kqfj1"), SubResource("Resource_uoux4"), SubResource("Resource_rgfmb"), SubResource("Resource_le6i0"), SubResource("Resource_n656v")])
spellcasting = SubResource("Resource_ml2om")
equipment_pack = Array[ExtResource("2_uoux4")]([SubResource("Resource_c1csv"), SubResource("Resource_sjbug"), SubResource("Resource_ysuoh"), SubResource("Resource_2fmwq"), SubResource("Resource_3hcux"), SubResource("Resource_doyp5"), SubResource("Resource_i4360"), SubResource("Resource_wxfjo")])
alternative_gold = 150
