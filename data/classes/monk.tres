tool_proficiencies = Array[StringName]([&"artisan_tools"])
skill_pool = Array[StringName]([&"acrobatics", &"athletics", &"history", &"insight", &"religion", &"stealth"])
features = Array[ExtResource("3_50m27")]([SubResource("Resource_u7xin"), SubResource("Resource_5f0mi"), SubResource("Resource_2ycw2"), SubResource("Resource_tnird"), SubResource("Resource_50m27"), SubResource("Resource_lrsp7"), SubResource("Resource_4yfhe"), SubResource("Resource_sovbd"), SubResource("Resource_iec8j")])
equipment_pack = Array[ExtResource("2_tnird")]([SubResource("Resource_xktgg"), SubResource("Resource_x2c20"), SubResource("Resource_fdnlq"), SubResource("Resource_8m7p0")])
alternative_gold = 50
