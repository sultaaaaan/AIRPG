[resource]
script = ExtResource("4_lrsp7")
id = &"monk"
display_name = "Монах"
description = "Боец, превращающий тело в оружие через дисциплину и внутреннюю энергию."
primary_abilities = Array[StringName]([&"dexterity", &"wisdom"])
