[gd_resource type="Resource" script_class="ClassData" format=3]

[ext_resource type="Script" path="res://scripts/data/choice_group_data.gd" id="1_idkma"]
[ext_resource type="Script" path="res://scripts/data/choice_option_data.gd" id="2_fdpiw"]
[ext_resource type="Script" path="res://scripts/data/feature_data.gd" id="3_hwoij"]
