level = 2

[sub_resource type="Resource" id="Resource_fdpiw"]
script = ExtResource("3_hwoij")
id = &"sear_undead"
display_name = "Выжигание нежити"
description = "Изгнанная нежить получает урон излучением, пока изгнана."
