[sub_resource type="Resource" id="Resource_023sm"]
script = ExtResource("6_ieupu")
ability = &"wisdom"
cantrips_known = 3
spells_prepared = 4
level_1_slots = 2

[resource]
script = ExtResource("5_ismnt")
id = &"cleric"
display_name = "Жрец"
description = "Проводник воли божества, лечащий союзников и карающий нечестивых."
primary_abilities = Array[StringName]([&"wisdom"])
saving_throws = Array[StringName]([&"wisdom", &"charisma"])
armor_training = Array[StringName]([&"light", &"medium", &"shields"])
weapon_training = Array[StringName]([&"simple"])
skill_pool = Array[StringName]([&"history", &"insight", &"medicine", &"persuasion", &"religion"])
features = Array[ExtResource("3_hwoij")]([SubResource("Resource_idkma"), SubResource("Resource_fdpiw")])
choices = Array[ExtResource("1_idkma")]([SubResource("Resource_gqg7p")])
spellcasting = SubResource("Resource_023sm")
equipment_pack = Array[ExtResource("4_i3dw4")]([SubResource("Resource_r4cnf"), SubResource("Resource_qtf1i"), SubResource("Resource_2w516"), SubResource("Resource_t7hp3"), SubResource("Resource_6oo2a")])
alternative_gold = 110
