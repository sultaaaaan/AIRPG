[sub_resource type="Resource" id="Resource_eeqf8"]
script = ExtResource("2_fdpiw")
id = &"protector"
display_name = "Защитник"
description = "Вы получаете владение воинским оружием и тяжёлыми доспехами."
granted_armor_training = Array[StringName]([&"heavy"])
granted_weapon_training = Array[StringName]([&"martial"])

[sub_resource type="Resource" id="Resource_6lvtq"]
script = ExtResource("3_hwoij")
id = &"thaumaturge_bonus"
display_name = "Богословская учёность"
description = "+модификатор Мудрости к проверкам Религии и один дополнительный заговор."

[sub_resource type="Resource" id="Resource_qkyia"]
script = ExtResource("2_fdpiw")
id = &"thaumaturge"
display_name = "Чудотворец"
description = "Вы знаете один дополнительный заговор жреца и добавляете модификатор Мудрости к проверкам Интеллекта (Религия)."
features = Array[ExtResource("3_hwoij")]([SubResource("Resource_6lvtq")])

[sub_resource type="Resource" id="Resource_gqg7p"]
script = ExtResource("1_idkma")
id = &"divine_order"
prompt = "Выберите божественный орден"
options = Array[ExtResource("2_fdpiw")]([SubResource("Resource_eeqf8"), SubResource("Resource_qkyia")])

[sub_resource type="Resource" id="Resource_r4cnf"]
script = ExtResource("4_i3dw4")
