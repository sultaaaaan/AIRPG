[sub_resource type="Resource" id="Resource_ksc3b"]
script = ExtResource("2_co7ix")
id = &"lucky"
display_name = "Удачливый"
description = "У вас есть очки удачи (равны бонусу мастерства). Потратьте одно, чтобы перебросить d20 или наложить помеху на атаку по вам."

[resource]
script = ExtResource("3_cijfc")
id = &"merchant"
display_name = "Торговец"
description = "Вы умели торговаться, считать прибыль и находить подход к людям."
ability_options = Array[StringName]([&"constitution", &"intelligence", &"charisma"])
skill_proficiencies = Array[StringName]([&"animal_handling", &"persuasion"])
tool_proficiency = &"navigators_tools"
origin_feat = SubResource("Resource_ksc3b")
equipment_pack = Array[ExtResource("1_cxen1")]([SubResource("Resource_dmpib"), SubResource("Resource_6en0y"), SubResource("Resource_tu1jl")])
