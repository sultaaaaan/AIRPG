[ext_resource type="Script" path="res://scripts/data/background_data.gd" id="3_cijfc"]

[sub_resource type="Resource" id="Resource_dmpib"]
script = ExtResource("1_cxen1")
item_id = &"navigators_tools"
display_name = "Инструменты штурмана"

[sub_resource type="Resource" id="Resource_6en0y"]
