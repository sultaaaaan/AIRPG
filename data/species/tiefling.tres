id = &"chthonic"
display_name = "Хтоническое"
description = "Заговор «Ледяное прикосновение»; сопротивление некротике. С 3 — «Ложная жизнь», с 5 — «Луч слабости»."

[sub_resource type="Resource" id="Resource_5xaaa"]
script = ExtResource("2_hcbaw")
id = &"infernal"
display_name = "Инфернальное"
description = "Заговор «Огненный снаряд»; сопротивление огню. С 3 — «Адское возмездие», с 5 — «Тьма»."

[sub_resource type="Resource" id="Resource_ltjmv"]
