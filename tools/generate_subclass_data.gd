extends SceneTree
## One-shot generator for res://data/subclasses/*.tres.
##
##   godot --headless --path . --script res://tools/generate_subclass_data.gd
##
## Level-3 features only: that is where every 2024 subclass starts, and the
## game currently tops out at level 1. Higher-level features are added when
## levelling lands.

const OUT_DIR := "res://data/subclasses"

const EXPECTED := 48


func _initialize() -> void:
	DirAccess.make_dir_recursive_absolute(ProjectSettings.globalize_path(OUT_DIR))

	var saved := 0
	for definition in _definitions():
		var data := _build(definition)
		var problems := data.validate()
		if not problems.is_empty():
			printerr("[%s] %s" % [data.id, ", ".join(problems)])

		var path := "%s/%s_%s.tres" % [OUT_DIR, data.class_id, data.id]
		var error := ResourceSaver.save(data, path)
		if error != OK:
			printerr("Failed to save %s: %s" % [path, error_string(error)])
		else:
			print("saved %s" % path)
			saved += 1

	print("done: %d subclasses" % saved)
	quit(0 if saved == EXPECTED else 1)


func _build(d: Dictionary) -> SubclassData:
	var s := SubclassData.new()
	s.id = d["id"]
	s.class_id = d["class"]
	s.display_name = d["name"]
	s.description = d["desc"]
	s.unlock_level = 3

	for feature in d["features"]:
		s.features.append(_feature(feature[0], feature[1], feature[2]))
	for choice in d.get("choices", []):
		s.choices.append(_choice(choice))
	return s


func _feature(feature_id: StringName, display_name: String, description: String) -> FeatureData:
	var f := FeatureData.new()
	f.id = feature_id
	f.display_name = display_name
	f.description = description
	f.level = 3
	return f


func _choice(d: Dictionary) -> ChoiceGroupData:
	var group := ChoiceGroupData.new()
	group.id = d["id"]
	group.prompt = d["prompt"]
	group.count = 1
	for option in d["options"]:
		var entry := ChoiceOptionData.new()
		entry.id = option[0]
		entry.display_name = option[1]
		entry.description = option[2]
		group.options.append(entry)
	return group


